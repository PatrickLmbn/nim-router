NVIDIA_API_KEYS=your_nvidia_api_key_1,your_nvidia_api_key_2
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
CEREBRAS_API_KEYS=your_cerebras_api_key_1,your_cerebras_api_key_2
OPENROUTER_API_KEYS=your_openrouter_api_key_1,your_openrouter_api_key_2
OPENCODE_API_KEY=your_opencode_api_key
BAI_API_KEY=your_bai_api_key
# Optional: Kiro (AWS CodeWhisperer). Usually set for you by the sign-in
# flow: click "Sign in with Google" in the web UI, or run `nim kiro-login`.
# You do NOT need the Kiro CLI installed.
KIRO_REFRESH_TOKEN=your_kiro_refresh_token
# Optional: Antigravity (Google). Usually set for you by the sign-in
# flow: click "Sign in with Google" in the web UI, or run `nim agy-login`.
# The account must be a personal Google account verified for Antigravity.
ANTIGRAVITY_REFRESH_TOKEN=your_antigravity_refresh_token
# Optional: DeepSeek Web (chat.deepseek.com session replay). Leave empty to
# auto-extract the userToken from a local browser profile (Brave/Chrome/Chromium).
# Set DEEPSEEK_WEB_TOKEN to override the browser extraction via .env.
DEEPSEEK_WEB_TOKEN=
DEEPSEEK_WEB_DS_SESSION_ID=
# Optional: Gemini Web (gemini.google.com session replay). Leave empty to
# auto-extract the __Secure-1PSID cookie from a local browser profile
# (Brave/Chrome/Chromium). Set GEMINI_WEB_COOKIE to a full cookie string to
# override browser extraction, or use GEMINI_WEB_1PSID (+ optional
# GEMINI_WEB_1PSIDTS and GEMINI_WEB_SAPISID) for individual cookie values.
GEMINI_WEB_COOKIE=
GEMINI_WEB_1PSID=
GEMINI_WEB_1PSIDTS=
GEMINI_WEB_SAPISID=
PORT=11435
PRIMARY_MODEL=nim-free
MAX_LATENCY_THRESHOLD=3.0
ROUTING_STRATEGY=fallback
